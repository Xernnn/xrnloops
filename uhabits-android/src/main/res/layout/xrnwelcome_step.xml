<?xml version="1.0" encoding="utf-8"?>
<!-- xrnloops welcome screen: one step of the loop (badge, name, what happens). The rail under
     the badge joins it to the next step; the last step hides it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/xrnwelcomeStepBadge"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/xrnwelcome_badge">

            <ImageView
                android:id="@+id/xrnwelcomeStepIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/xrn_green" />
        </FrameLayout>

        <View
            android:id="@+id/xrnwelcomeStepRail"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:minHeight="18dp"
            android:background="@color/xrn_surface_high" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/xrnwelcomeStepTitle"
            style="@style/XrnText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/xrnwelcomeStepBody"
            style="@style/XrnText.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
