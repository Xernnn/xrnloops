<?xml version="1.0" encoding="utf-8"?>
<!-- xrnloops welcome screen (xrnwelcome/WelcomeActivity): the pages, then dots and buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/xrnwelcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xrn_bg"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/xrnwelcomePager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/xrnwelcomeBack"
            style="@style/XrnButton.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="88dp"
            android:text="@string/xrnwelcome_skip" />

        <LinearLayout
            android:id="@+id/xrnwelcomeDots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/xrnwelcomeNext"
            style="@style/XrnButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="112dp"
            android:text="@string/xrnwelcome_next" />
    </LinearLayout>
</LinearLayout>
