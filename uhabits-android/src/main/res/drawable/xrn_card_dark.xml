<?xml version="1.0" encoding="utf-8"?>
<!-- xrnloops (XRNLOOPS.md): a habit page card, dark xrn theme. The inset keeps the gap between cards inside
     the background, so Loop's card margins stay as they are. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp"
    android:insetTop="3dp"
    android:insetRight="2dp"
    android:insetBottom="3dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/xrn_surface" />
        <stroke android:width="1dp" android:color="@color/xrn_outline" />
        <corners android:radius="24dp" />
    </shape>
</inset>
