<?xml version="1.0" encoding="utf-8"?>
<!-- xrnloops (XRNLOOPS.md): Nunito as one family, so textStyle="bold" picks the bold file
     instead of a synthetic bold. SIL OFL 1.1, see assets/licenses/Nunito-OFL.txt. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/xrn_nunito_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/xrn_nunito_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/xrn_nunito_extrabold"
        android:fontStyle="normal"
        android:fontWeight="800" />
</font-family>
