<?xml version="1.0" encoding="utf-8"?>
<!-- xrnloops (XRNLOOPS.md): what a tap on a day does, and the flick menu a short hold opens. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="xrntap_title">Tap on a day</string>
    <!-- %s is the picked choice (ListPreference fills it in). -->
    <string name="xrntap_summary">%s. Hold a day for a moment and slide: up ✓, down ✗, left – (skip); let go in the middle for ?. On a number day, up and down add and take off its step.</string>
    <string-array name="xrntap_entries">
        <item>Ticks it ✓ (tap again to clear)</item>
        <item>Cycles ✓ ✗ ? (Loop\'s way)</item>
    </string-array>
    <string-array name="xrntap_values" translatable="false">
        <item>tick</item>
        <item>cycle</item>
    </string-array>
</resources>
